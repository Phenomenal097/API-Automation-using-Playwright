<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Test Suite" verbose="1" parallel="tests" thread-count="4">

    <test name="Create User Tests">
        <classes>
            <class name="com.framework.tests.CreateUserTest"/>
        </classes>
    </test>

    <test name="Get User Tests">
        <classes>
            <class name="com.framework.tests.GetUserTest"/>
        </classes>
    </test>

    <test name="Get Users Tests">
        <classes>
            <class name="com.framework.tests.GetUsersTest"/>
        </classes>
    </test>

    <test name="Put Users Tests">
        <classes>
            <class name="com.framework.tests.UpdateUserTest" />
        </classes>
    </test>

</suite>